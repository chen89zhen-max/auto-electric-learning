# 群晖反向代理可访问的本机监听地址；不要直接暴露到公网。
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
TZ=Asia/Shanghai

# 正式环境固定关闭演示账号。真实凭据由管理员在系统内一次性创建和交付。
ENABLE_DEMO_SEED=false

# 全通关人工测试账号 student_pass（密码 Student#2026）：默认开启，方便教师直接进任意关卡测试；
# 每次容器重启该账号进度自动恢复为全部通关。不需要时改为 false。
ENABLE_TEST_PASS_ACCOUNT=true

# 首次建库时创建系统管理员。部署前必须填写强密码；首次登录后系统会强制改密。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
