# 当前调试部署：群晖 3001 对外监听，路由器可将公网 23000/TCP 转发到此端口。
# 正式使用真实账号和学生数据前，应改用 HTTPS 反向代理或 VPN。
BIND_ADDRESS=0.0.0.0
APP_PORT=3001
TZ=Asia/Shanghai

# 正式环境固定关闭演示账号。真实凭据由管理员在系统内一次性创建和交付。
ENABLE_DEMO_SEED=false

# 全通关人工测试账号 student_pass（密码 Student#2026）：默认开启，方便教师直接进任意关卡测试；
# 每次容器重启该账号进度自动恢复为全部通关。不需要时改为 false。
ENABLE_TEST_PASS_ACCOUNT=true

# 仅全新空数据库首次启动时必填；已有管理员的数据库更新重建时可留空。
# 首次登录后系统会强制改密。真实值只写在群晖本机 .env，不提交到 Git。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
